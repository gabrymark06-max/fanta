# Token del bot, da @BotFather su Telegram (comando /newbot).
TELEGRAM_BOT_TOKEN=

# Chi puo' usare il bot: id numerici Telegram separati da virgola.
# Il tuo id te lo dice @userinfobot. Lasciarlo vuoto apre il bot a chiunque
# ne conosca il nome: durante un'asta e' esattamente quello che non vuoi.
UTENTI_AMMESSI=

# Solo se lo fai girare come web app (PythonAnywhere) invece che in
# polling: la parolina che Telegram rimanda a ogni chiamata. Generala
# con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
